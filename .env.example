# =====================================================================
# CONFIGURACIÓN DE PASARELA DE PAGOS WOMPI (BANCOLOMBIA) PARA FARMABOY
# =====================================================================
# Cuando tengas tus credenciales de Wompi (desde tu portal https://comercios.wompi.co):
# 1. Reemplaza los valores de prueba por tus llaves reales.
# 2. Cambia NEXT_PUBLIC_WOMPI_ENV a "prod" cuando vayas a recibir pagos reales.

# Llave pública de Wompi (comienza con pub_test_ para pruebas o pub_prod_ para producción)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_PLACEHOLDER_FARMABOY"

# Llave privada de Wompi (comienza con prv_test_ o prv_prod_) - Mantener secreta
WOMPI_PRIVATE_KEY="prv_test_PLACEHOLDER_FARMABOY"

# Secreto de integridad de Wompi (encontrado en portal de Wompi > Desarrolladores > Secreto de integridad)
WOMPI_INTEGRITY_SECRET="test_integrity_PLACEHOLDER_FARMABOY"

# Entorno de Wompi: "test" o "prod"
NEXT_PUBLIC_WOMPI_ENV="test"

# URL base del sitio para redirección post-pago
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
