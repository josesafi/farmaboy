# Configuración de Servidor de Correo Transaccional Farmaboy
# Remitente corporativo
EMAIL_FROM=info@farmaboy.com
EMAIL_FROM_NAME="Farmaboy"

# Conexión SMTP
SMTP_HOST=smtp.buzondecorreo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@farmaboy.com
SMTP_PASSWORD=INSERTE_CONTRASENA_AQUI

# Destinatario para alertas y notificaciones del sistema administrativo
ADMIN_EMAIL=info@farmaboy.com

# URL base para enlaces en correos (confirmación, reseteo, pedidos)
NEXT_PUBLIC_SITE_URL=https://farmaboy.com

# Clave secreta para tokens criptográficos temporales de un solo uso
EMAIL_JWT_SECRET=farmaboy_secure_jwt_token_secret_2026_boyaca
